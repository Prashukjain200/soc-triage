# Copy this file to .env and fill in real values. Never commit the real .env file.

# OpenAI (LLM for every agent)
OPENAI_API_KEY=sk-your-openai-key-here

# Serper.dev (Google Search API) - used by ip_internet_lookup
# Get a free key at https://serper.dev
SERPER_API_KEY=your-serper-key-here

# Pushover (push notifications) - used by notify_admin
PUSHOVER_TOKEN=your-pushover-app-token-here
PUSHOVER_USER=your-pushover-user-key-here

# Optional overrides (defaults are set in src/soc_triage/config.py)
# CHAT_MODEL=gpt-5.6-luna
# CHAT_REASONING_EFFORT=none
# FALLBACK_MODEL=gpt-4o-mini
